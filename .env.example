# getproperty-web — every environment variable this app reads.
#
# F0 reads only the three zone hosts (src/proxy.ts). The validated env schema (src/lib/env) arrives in
# F1 together with the BFF; this file is kept in step with it from then on. Copy to .env.local for
# local work. Anything NEXT_PUBLIC_* is compiled into the browser bundle and is public by definition.
#
# Outside production the hosts default to the values shown, so `pnpm dev` needs no .env at all.

# ── Zones (00-master-plan.md §2) ─────────────────────────────────────────────────────────────
# Host header values, not URLs. The port is ignored when matching, so the same values work on
# :3000, :3100 and :3200.
OWNER_HOST=localhost:3000
STAFF_HOST=staff.localhost:3000
ADMIN_HOST=admin.localhost:3000

# Optional allow-list: which zones this deployment answers for. Unset means all three.
# ZONES=owner,staff
#
# There is no resident/LIFF host here: the resident LINE Mini App is the separate repository
# getproperty-liff (D-154). In the platform's naming a "tenant" is the SaaS customer organisation (D-151).

# ── Backend (getproperty-api) — F1 ───────────────────────────────────────────────────────────
# Server-to-server only. Browser code calls this app's own /bff/* instead (ADR-0004, F1).
# API_INTERNAL_URL=http://localhost:4000
# API_CONTRACT_SOURCE=../getproperty-api/contract/openapi.json

# ── Observability (F1 1.3) ───────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ENV_BADGE=uat
