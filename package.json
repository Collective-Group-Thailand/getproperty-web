{
  "name": "getproperty-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "dev:mock": "tsx scripts/dev-mock.ts",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/lib/pwa/sw/tsconfig.json",
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "icons": "tsx scripts/build-icons.ts",
    "icons:check": "tsx scripts/build-icons.ts --check",
    "brand": "tsx scripts/build-brand.ts",
    "brand:check": "tsx scripts/build-brand.ts --check",
    "contrast": "tsx scripts/check-contrast.ts",
    "fonts": "tsx scripts/copy-fonts.ts",
    "gen:api": "tsx scripts/gen-api.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium --project=owner",
    "e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lhci": "tsx scripts/lhci.ts",
    "release:hygiene": "tsx scripts/release-hygiene.ts",
    "postinstall": "tsx scripts/copy-fonts.ts",
    "mock:api": "tsx mocks/server.ts",
    "gen:api:check": "tsx scripts/gen-api.ts --check",
    "e2e:integration": "playwright test --config playwright.integration.config.ts",
    "sw": "tsx scripts/build-sw.ts",
    "sw:check": "tsx scripts/build-sw.ts --check",
    "e2e:visual": "playwright test --config playwright.visual.config.ts"
  },
  "dependencies": {
    "@collective/content": "file:../../collective-shared/packages/content",
    "@collective/web-kit": "file:../../collective-shared/packages/web-kit",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@prometheus-io/client": "0.16.1",
    "@sentry/nextjs": "^11.8.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "next": "16.4.2",
    "next-intl": "^4.14.6",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/anuphan": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.6",
    "intl-messageformat": "^10.7.18",
    "jsdom": "^30.1.1",
    "lucide-react": "1.58.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "msw",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@collective/web-kit": "file:../../collective-shared/packages/web-kit"
    }
  }
}
