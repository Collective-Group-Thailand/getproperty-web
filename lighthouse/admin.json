{
  "extends": "./shared.json",
  "$comment": "Platform admin console: LCP ≤ 2.5 s, CLS ≤ 0.1, initial JS ≤ 260 KB gz (D-179, docs/performance-budgets.md) — a hard limit on every URL. Measured signed in as a platform admin (scripts/lhci.ts). F5: home queues, tenants list/detail/subscription/pilot, a platform invoice, the tariff manager, settings, audit, outbox, fleet list/gateway and a live OTA rollout. One run per URL; the JS size does not vary between runs.",
  "ci": {
    "collect": {
      "url": [
        "http://admin.localhost:3200/",
        "http://admin.localhost:3200/tenants",
        "http://admin.localhost:3200/tenants/0d0c7a4e-5b0e-4c55-9d7c-3f2b8a1e6c11",
        "http://admin.localhost:3200/tenants/0d0c7a4e-5b0e-4c55-9d7c-3f2b8a1e6c11/subscription",
        "http://admin.localhost:3200/tenants/0d0c7a4e-5b0e-4c55-9d7c-3f2b8a1e6c11/pilot",
        "http://admin.localhost:3200/subscriptions/invoices/8b000000-0000-4000-8000-000000000001",
        "http://admin.localhost:3200/tariffs/9b000000-0000-4000-8000-000000000001",
        "http://admin.localhost:3200/settings",
        "http://admin.localhost:3200/audit",
        "http://admin.localhost:3200/outbox",
        "http://admin.localhost:3200/devices",
        "http://admin.localhost:3200/devices/2f6c1d7e-9a3b-4c5d-8e7f-0a1b2c3d4e03",
        "http://admin.localhost:3200/ota/rollouts/aa000000-0000-4000-8000-000000000001"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "chromeFlags": "--host-resolver-rules=MAP *.localhost 127.0.0.1"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 266240
          }
        ]
      }
    }
  }
}
