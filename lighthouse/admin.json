{
  "extends": "./shared.json",
  "$comment": "Platform admin console: LCP ≤ 2.5 s, CLS ≤ 0.1, initial JS ≤ 260 KB gz (D-179, docs/performance-budgets.md) — a hard limit. Measured signed in as a platform user (scripts/lhci.ts). F5 adds tenants, tariffs and fleet URLs.",
  "ci": {
    "collect": {
      "url": ["http://admin.localhost:3200/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "chromeFlags": "--host-resolver-rules=MAP *.localhost 127.0.0.1"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 266240
          }
        ]
      }
    }
  }
}
