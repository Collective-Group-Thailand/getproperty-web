{
  "extends": "./shared.json",
  "$comment": "Tenant LIFF pages on a mid-range Android over 4G: LCP ≤ 2.0 s, CLS ≤ 0.05, initial JS ≤ 150 KB gz (docs/performance-budgets.md). Measured as a phone with the Lighthouse mobile preset. The tenant host is reached through its Host header; the URLs name the host the server was given (`TENANT_HOST`). F3 adds home, bills/[id], pay, receipts.",
  "ci": {
    "collect": {
      "url": ["http://tenant.localhost:3200/"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 780,
          "deviceScaleFactor": 2.625,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": { "rttMs": 150, "throughputKbps": 1638.4, "cpuSlowdownMultiplier": 4 },
        "chromeFlags": "--host-resolver-rules=MAP *.localhost 127.0.0.1"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 153600 }]
      }
    }
  }
}
