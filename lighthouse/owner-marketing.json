{
  "extends": "./shared.json",
  "$comment": "Owner-host marketing pages (F1 1.3 §7): LCP ≤ 2.0 s, CLS ≤ 0.05, initial JS ≤ 120 KB gz (docs/performance-budgets.md). Public, no session; SEO category asserted too. RATCHET (F1 1.3, 2026-10-17): measured 189–199 KB; ceiling 200 KB until the root bundle shrinks (see docs/performance-budgets.md › Ratchets) — target 120 KB.",
  "ci": {
    "collect": {
      "url": ["http://localhost:3200/", "http://localhost:3200/en", "http://localhost:3200/pricing"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.05
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 204800
          }
        ]
      }
    }
  }
}
